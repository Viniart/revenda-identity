POSTGRES_USER=revenda
POSTGRES_PASSWORD=revenda

# O emissor precisa ser um endereco alcancavel tanto do host quanto de dentro do
# conteiner de revenda-vehicles: e a partir dele que o documento de discovery monta a
# URL do JWKS, e e essa URL que o servico de veiculos busca para validar o token.
# "localhost" nao serve, porque dentro daquele conteiner aponta para ele mesmo.
JWT_ISSUER=http://host.docker.internal:8081
JWT_AUDIENCE=revenda-vehicles
# Chave privada RSA em PEM. Se ficar vazia, uma chave efemera e gerada na subida e os
# tokens emitidos deixam de valer a cada reinicio. Gere com:
#   openssl genrsa -out identity.pem 2048
JWT_PRIVATE_KEY_PEM=

ADMIN_NAME=Administrador da Revenda
ADMIN_CPF=11144477735
ADMIN_EMAIL=admin@revenda.com
ADMIN_PASSWORD=Revenda2026
